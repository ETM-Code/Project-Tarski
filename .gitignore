.vscode/
**/.DS_Store

# Local workspace state
voice/

# Python
**/__pycache__/
**/*.py[cod]
**/.venv/
**/venv/

# JavaScript / frontend
**/node_modules/
**/dist/
**/*.tsbuildinfo

# Rust / native build outputs
**/target/

